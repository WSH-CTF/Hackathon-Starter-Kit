# Copy this file to .env and fill in your own keys.
# Never commit your real .env file to GitHub!

PORT=3001

# Google Safe Browsing API (free tier) - https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=your_key_here

# VirusTotal API (free tier) - https://developers.virustotal.com/reference
VIRUSTOTAL_API_KEY=your_key_here

# OpenAI or Anthropic API (optional, for AI-powered features)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Firebase / Supabase / MongoDB Atlas connection details (if used)
FIREBASE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
MONGODB_URI=
